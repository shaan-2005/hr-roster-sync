      "result": "{\"status\": \"ok\"}"
    },
    {
      "title": "New employee",
      "command": "POST /api/hr/events/ version=1",
      "result": "{\"results\": [{\"index\": 0, \"employee_id\": \"demo-20261030201949\", \"result\": \"applied\"}]}"
    },
    {
      "title": "Duplicate feed is harmless",
      "command": "POST /api/hr/events/ version=1 again",
      "result": "{\"results\": [{\"index\": 0, \"employee_id\": \"demo-20261030201949\", \"result\": \"duplicate\"}]}"
    },
    {
      "title": "Older update is ignored",
      "command": "POST /api/hr/events/ version=0",
      "result": "{\"results\": [{\"index\": 0, \"employee_id\": \"demo-20261030201949\", \"result\": \"stale\"}]}"
    },
    {
      "title": "Transport field survives HR sync",
      "command": "PATCH pickup; POST version=2; GET employee",
      "result": "{\"employee_id\": \"demo-20261030201949\", \"office\": \"BLR\", \"shift\": \"evening\", \"active\": true, \"pickup_point\": \"Gate 2\", \"source_version\": 2}"
    },
    {
      "title": "Broken nightly file is stopped",
      "command": "POST /api/imports/ header-only CSV",
      "result": "{\"run_id\": 5, \"status\": \"needs_review\", \"rows\": 0, \"invalid\": 0, \"missing\": 1} | employee active=true"
    },
    {
      "title": "Failure injected",
      "command": "docker compose stop worker",
      "result": "Outbox worker stopped before deactivation"
    },
    {
      "title": "Change commits while worker is down",
      "command": "POST deactivation version=3; inspect database",
      "result": "{\"results\": [{\"index\": 0, \"employee_id\": \"demo-20261030201949\", \"result\": \"applied\"}]} | 19 objects imported automatically (use -v 2 for details). |  | booking=booked | pending=1"
    },
    {
      "title": "Worker recovers safely",
      "command": "docker compose up -d worker; inspect booking and outbox",
      "result": "19 objects imported automatically (use -v 2 for details). |  | booking=cancelled, seat_released=True | pending=0"
    }
  ]
